---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${profile.name} · ${profile.role}`,
  description = `${profile.name}, ${profile.role.toLowerCase()}. ${profile.tagline}`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F1A17" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <script is:inline>
      // Turn on motion only when allowed; without JS everything stays visible.
      // ?nomotion shows the finished page (handy for screenshots).
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && !/[?&]nomotion/.test(location.search)) {
        document.documentElement.classList.add('motion');
        // Safety net: if the motion script never starts, show everything.
        setTimeout(function () {
          if (!window.__motionReady) document.documentElement.classList.remove('motion');
        }, 3000);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
