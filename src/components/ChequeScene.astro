---
// A chalk drawing of a cheque; detection boxes draw in one after another.
const hand = 'M0 0 c6 -10 10 8 16 -2 s8 -10 14 0 s10 6 16 -4 s8 -6 14 2 s10 4 16 -6 s10 2 14 4';
---

<svg viewBox="0 0 400 210" class="block h-full w-full" fill="none" aria-hidden="true" data-draw>
  <rect width="400" height="210" fill="#13201c" />
  <g stroke="#E8EFE9" stroke-opacity="0.75" stroke-width="1.6" stroke-linecap="round">
    <rect x="22" y="24" width="356" height="162" rx="6" />
    <path d="M40 46 h70 M40 56 h46" stroke-opacity="0.4" stroke-width="5" />
    <path d="M40 98 H250" stroke-opacity="0.35" />
    <path d="M40 130 H300" stroke-opacity="0.35" />
    <path d="M270 166 H360" stroke-opacity="0.35" />
  </g>
  <text x="292" y="54" fill="#A3B5AC" font-family="JetBrains Mono, monospace" font-size="12">2026/05/14</text>
  <g stroke="#E8EFE9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d={`M52 92 ${hand.slice(4)}`} />
    <path d="M52 124 c6 -10 10 8 16 -2 s8 -10 14 0 s10 6 16 -4 s8 -6 14 2 s10 4 16 -6 s10 2 14 4 s8 -8 14 0 s8 6 14 -2 s8 -6 14 2" />
    <path d="M282 160 c10 -18 16 10 24 -6 s10 -14 18 2 s8 4 20 -10" />
  </g>
  <rect x="268" y="80" width="92" height="30" rx="3" stroke="#E8EFE9" stroke-opacity="0.75" stroke-width="1.6" />
  <text x="280" y="100" fill="#E8EFE9" font-family="JetBrains Mono, monospace" font-size="14">1,250.00</text>

  <!-- detections -->
  <g stroke="#F2D06B" stroke-width="1.6" stroke-linejoin="round">
    <rect class="draw" pathLength="1" x="286" y="38" width="80" height="24" rx="2" style="--d: 300ms; --dur: 0.6s" />
    <rect class="draw" pathLength="1" x="262" y="74" width="104" height="42" rx="2" style="--d: 800ms; --dur: 0.6s" />
    <rect class="draw" pathLength="1" x="44" y="106" width="206" height="32" rx="2" style="--d: 1300ms; --dur: 0.7s" />
  </g>
  <g font-family="JetBrains Mono, monospace" font-size="10.5" fill="#F2D06B" letter-spacing="0.5">
    <text class="pop" x="286" y="33" style="--d: 700ms">DATE</text>
    <text class="pop" x="366" y="129" text-anchor="end" style="--d: 1200ms">DIGITS 0.98</text>
    <text class="pop" x="44" y="151" style="--d: 1800ms">WORDS 0.95</text>
  </g>
  <g class="pop" style="--d: 2300ms">
    <rect x="36" y="161" width="150" height="21" rx="10.5" fill="#F2D06B" />
    <text x="48" y="175.5" fill="#0F1A17" font-family="JetBrains Mono, monospace" font-size="11" font-weight="500">AMOUNTS MATCH ✓</text>
  </g>
</svg>
