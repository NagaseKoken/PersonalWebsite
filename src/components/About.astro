---
import SectionHeading from './SectionHeading.astro';
import { about } from '../data/site';
---

<section id="about" class="container-x pt-24 md:pt-32" aria-labelledby="about-title">
  <SectionHeading num="01" title="About" id="about-title" />

  <div class="grid gap-14 lg:grid-cols-[1.2fr_1fr] lg:gap-24">
    <div>
      <p class="text-2xl leading-snug text-chalk md:text-[1.75rem]" data-reveal>{about.lead}</p>
      <p class="mt-6 max-w-[36rem] text-[1.0625rem] leading-relaxed text-muted" data-reveal style="--d: 120ms">{about.body}</p>

      <dl class="mt-12 grid grid-cols-3 gap-x-5 gap-y-8 sm:flex sm:flex-wrap sm:gap-x-12">
        {about.stats.map((s, i) => (
          <div data-reveal style={`--d: ${240 + i * 120}ms`}>
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-sketch text-[1.9rem] leading-none text-yellow whitespace-nowrap sm:text-[2.75rem]">
              <span data-count={s.value} data-decimals={s.decimals} data-prefix={s.prefix ?? ''} data-suffix={s.suffix}>
                {(s.prefix ?? '') + s.value.toFixed(s.decimals) + s.suffix}
              </span>
            </dd>
            <dd class="label mt-2 text-muted" aria-hidden="true">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure>
      <div class="rounded-md border border-dashed border-faint/70 bg-board-2/60 p-7 md:p-8" data-reveal style="--d: 200ms">
        {about.toolbox.map((g, gi) => (
          <div class:list={['py-5 first:pt-0 last:pb-0', gi > 0 && 'border-t border-line']}>
            <p class="label text-faint">{g.group}</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {g.items.map((it) => <li class="chip">{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <figcaption class="mt-3 font-hand text-xl text-faint" data-reveal style="--d: 400ms">fig. 2 — the toolbox</figcaption>
    </figure>
  </div>
</section>
